# ===== Google Sheets 設定 =====

# スプレッドシートのID（URLの /d/ と /edit の間の文字列）
SPREADSHEET_ID=your_spreadsheet_id_here

# Flask のシークレットキー（セッション・フラッシュメッセージ用）
SECRET_KEY=your-secret-key-here

# 本番環境（Render）では credentials.json の中身をここに貼り付ける
# ローカルでは credentials.json ファイルを使うので不要
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}


# ===== LINE 通知設定（オプション） =====

# LINE Developers で取得したチャネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 通知を送る LINE アカウントのユーザー ID（LINE Developers のコンソールで確認）
LINE_USER_ID=your_line_user_id_here
